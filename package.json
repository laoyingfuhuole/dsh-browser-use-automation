{
  "name": "dsh-parallel-browser",
  "version": "0.3.3",
  "description": "面向 DeepSeek Harness 的后台浏览器自动化插件：按对话分配独立 Electron 窗口，共享登录状态，支持 CDP 输入和快照 ref，不抢焦点。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./host/main.cjs": "./host/main.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src",
    "host",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "scripts/check-install.mjs",
    "scripts/prepare-release.mjs",
    "scripts/check-runtime.mjs",
    "integrity.json"
  ],
  "scripts": {
    "check:install": "node scripts/check-install.mjs",
    "prepare:release": "node scripts/prepare-release.mjs",
    "check:release": "node scripts/prepare-release.mjs --check",
    "check:runtime": "node scripts/check-runtime.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "browser",
    "cdp",
    "electron",
    "automation",
    "parallel",
    "background"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.1.1-rc.2 <0.3.0"
  },
  "dependencies": {
    "electron": "^44.10.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-system-prompt": ">=0.1.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laoyingfuhuole/dsh-browser-use.git"
  },
  "homepage": "https://github.com/laoyingfuhuole/dsh-browser-use#readme",
  "bugs": {
    "url": "https://github.com/laoyingfuhuole/dsh-browser-use/issues"
  }
}
