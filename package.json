{
  "name": "dsh-browser-use-automation",
  "version": "0.4.1",
  "description": "面向 DeepSeek Harness 的完全后台浏览器自动化插件：每个对话一个离屏 Electron 窗口，真实 CDP 输入，不抢焦点，支持点击、输入、截图、读页与登录。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./host/main.cjs": "./host/main.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src",
    "host",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "scripts/check-install.mjs",
    "scripts/prepare-release.mjs",
    "scripts/check-runtime.mjs",
    "integrity.json"
  ],
  "scripts": {
    "test": "node scripts/test.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:install": "node scripts/check-install.mjs",
    "prepare:release": "node scripts/prepare-release.mjs",
    "check:release": "node scripts/prepare-release.mjs --check",
    "check:runtime": "node scripts/check-runtime.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "browser",
    "cdp",
    "electron",
    "automation",
    "parallel",
    "background",
    "browser-use",
    "headless-browser",
    "web-scraping",
    "screenshot"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.1.1-rc.2 <0.3.0"
  },
  "dependencies": {
    "electron": "^44.10.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-system-prompt": ">=0.1.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laoyingfuhuole/dsh-browser-use-automation.git"
  },
  "homepage": "https://github.com/laoyingfuhuole/dsh-browser-use-automation#readme",
  "bugs": {
    "url": "https://github.com/laoyingfuhuole/dsh-browser-use-automation/issues"
  }
}
